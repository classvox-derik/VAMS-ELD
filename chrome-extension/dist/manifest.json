{
  "manifest_version": 3,
  "name": "VAMS ELD",
  "short_name": "VAMS ELD",
  "version": "1.0.0",
  "description": "Valor Academy Middle School English Language Development - Scaffolding tools for ELD teachers",
  "author": {
    "email": "derik@brightstarschools.org"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "VAMS ELD",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "side_panel": {
    "default_path": "src/popup.html"
  },
  "background": {
    "service_worker": "service-worker-loader.js",
    "type": "module"
  },
  "permissions": [
    "sidePanel",
    "storage",
    "identity"
  ],
  "host_permissions": [
    "https://*.supabase.co/*",
    "https://openrouter.ai/*",
    "https://www.googleapis.com/*",
    "https://docs.googleapis.com/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  }
}
